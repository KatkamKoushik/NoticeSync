# ==============================================================================
# NoticeSync Environment Configuration Example
# Copy this file to .env.local for local development.
# IMPORTANT: DO NOT commit real secrets or production keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration (Authentication & PostgreSQL Vector Database)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# Pluggable Model Provider Configuration
# ------------------------------------------------------------------------------
# LLM_PROVIDER options: groq (default), gemini, ollama (local Gemma), mock
LLM_PROVIDER=groq

# EMBEDDING_PROVIDER options: google (default, 768-dim), mock
EMBEDDING_PROVIDER=google

# ------------------------------------------------------------------------------
# Groq AI Provider (Hosted LLM for Structured Extraction & Briefs)
# Supports rotation across up to 6 fallback API keys to mitigate rate limits
# ------------------------------------------------------------------------------
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY_1=your_primary_groq_api_key
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=

# ------------------------------------------------------------------------------
# Google Generative AI (Gemini LLM & 768-Dimension Vector Embeddings)
# ------------------------------------------------------------------------------
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=
GEMMA_API_KEY=your_google_gemini_api_key
GEMMA_API_KEY_2=
GEMMA_API_KEY_3=

# ------------------------------------------------------------------------------
# Local Gemma / Ollama Provider (Optional local inference)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:9b

# ------------------------------------------------------------------------------
# Observability & Tracing (Optional)
# ------------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=https://cloud.langfuse.com

# ------------------------------------------------------------------------------
# Test Mode Flag (Deterministic Mock AI & Memory DB for Offline/CI Testing)
# Set to 'true' in CI/test environments to execute without paid third-party APIs
# ------------------------------------------------------------------------------
NOTICE_SYNC_TEST_MODE=true
