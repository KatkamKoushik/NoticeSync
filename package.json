{
  "name": "notice-sync",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "test:unit": "tsx --test tests/ai/*.test.ts tests/ingestion/*.test.ts tests/security/*.test.ts",
    "test:integration": "tsx --test tests/api/*.test.ts tests/rag/*.test.ts tests/chat/*.test.ts tests/supabase/*.test.ts",
    "test:e2e": "tsx --test tests/e2e/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "audit:deps": "pnpm audit --prod",
    "eval": "tsx eval/runner.ts --split=all --mode=offline",
    "eval:dev": "tsx eval/runner.ts --split=dev --mode=offline",
    "eval:test": "tsx eval/runner.ts --split=test --mode=offline",
    "eval:live": "tsx eval/runner.ts --split=all --mode=live"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.50",
    "@ai-sdk/groq": "^4.0.30",
    "@ai-sdk/react": "^4.0.80",
    "@google/generative-ai": "^0.24.1",
    "@sentry/nextjs": "^10.78.0",
    "@supabase/supabase-js": "^2.112.3",
    "ai": "^7.0.77",
    "date-fns": "^4.4.0",
    "ics": "^3.12.0",
    "langfuse": "^3.38.20",
    "lucide-react": "^1.32.0",
    "next": "^16.4.3",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tesseract.js": "^7.0.0",
    "uuid": "^14.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.18.0"
}
